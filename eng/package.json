{
    "name": "@microsoft/vscode-azext-eng",
    "author": "Microsoft Corporation",
    "version": "1.2.0",
    "description": "Engineering package for Azure extensions for VS Code",
    "repository": {
        "type": "git",
        "url": "https://github.com/Microsoft/vscode-azuretools"
    },
    "license": "MIT",
    "exports": {
        "./esbuild": {
            "import": "./dist/esm/esbuild/esbuildConfigs.js",
            "require": "./dist/cjs/esbuild/esbuildConfigs.js",
            "types": "./dist/esm/esbuild/esbuildConfigs.d.ts"
        },
        "./esbuild/sass": {
            "import": "./dist/esm/esbuild/sassPlugin.js",
            "require": "./dist/cjs/esbuild/sassPlugin.js",
            "types": "./dist/esm/esbuild/sassPlugin.d.ts"
        },
        "./eslint": {
            "import": "./dist/esm/eslint/eslintConfigs.js",
            "require": "./dist/cjs/eslint/eslintConfigs.js",
            "types": "./dist/esm/eslint/eslintConfigs.d.ts"
        },
        "./vscode-test": {
            "import": "./dist/esm/vscode-test/vscodeTestConfigs.js",
            "require": "./dist/cjs/vscode-test/vscodeTestConfigs.js",
            "types": "./dist/esm/vscode-test/vscodeTestConfigs.d.ts"
        },
        "./mocha": {
            "import": "./dist/esm/mocha/index.mjs",
            "types": "./dist/esm/mocha/index.d.mts"
        },
        "./mocha/test-globals": {
            "import": "./dist/esm/mocha/test-globals.mjs",
            "types": "./dist/esm/mocha/test-globals.d.mts",
            "default": "./dist/esm/mocha/test-globals.mjs"
        },
        "./mocha/config": {
            "import": "./dist/esm/mocha/config.js",
            "require": "./dist/cjs/mocha/config.js",
            "types": "./dist/esm/mocha/config.d.ts"
        },
        "./vscode-test/cache": {
            "import": "./dist/esm/vscode-test/linkTestCache.js",
            "require": "./dist/cjs/vscode-test/linkTestCache.js",
            "types": "./dist/esm/vscode-test/linkTestCache.d.ts"
        }
    },
    "bin": {
        "azext-link-test-cache": "./dist/cjs/vscode-test/linkTestCacheCli.js"
    },
    "scripts": {
        "build": "npm run build:esm && npm run build:cjs",
        "build:esm": "node ./node_modules/@typescript/native/bin/tsc",
        "build:cjs": "node ./node_modules/@typescript/native/bin/tsc --outDir ./dist/cjs --module nodenext --moduleResolution nodenext --declaration false",
        "test": "npm run build && mocha",
        "lint": "eslint --max-warnings 0",
        "package": "npm pack"
    },
    "mocha": {
        "spec": "src/test/*.test.mts"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/chai": "^5.2.3",
        "@types/chai-as-promised": "^8.0.2",
        "@types/mocha": "^10.0.10",
        "chai": "^6.3.0",
        "chai-as-promised": "^8.0.2",
        "eslint": "^10.12.0",
        "mocha": "^11.8.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0"
    },
    "peerDependencies": {
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "sass": "^1.105.1",
        "tsx": "^4.23.15"
    },
    "peerDependenciesMeta": {
        "@vscode/test-cli": {
            "optional": true
        },
        "@vscode/test-electron": {
            "optional": true
        },
        "@vscode/vsce": {
            "optional": true
        },
        "esbuild": {
            "optional": true
        },
        "sass": {
            "optional": true
        },
        "tsx": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "24.x",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vscode/test-cli": "*",
        "@vscode/test-electron": "*",
        "esbuild": "*",
        "sass": "*"
    },
    "overrides": {
        "serialize-javascript": "^7.1.2"
    }
}
